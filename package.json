{
  "name": "pinguin",
  "productName": "Pinguin",
  "version": "1.0.0",
  "description": "Pinguin is a powerful, state-of-the-art offline AI built to help university students study faster, think deeper, and learn privately.",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "makeSquirrel": "electron-forge make --targets=\"@electron-forge/maker-squirrel\"",
    "bundle-python": "node scripts/bundle-python-runtime.js",
    "prepare-backend": "node scripts/prepare-python-backend.js",
    "setup-tesseract": "node scripts/download-tesseract.js",
    "setup-tesseract-dlls": "powershell -ExecutionPolicy Bypass -File scripts/copy-tesseract-dlls.ps1",
    "setup-tesseract-x64": "powershell -ExecutionPolicy Bypass -File scripts/setup-tesseract-x64.ps1",
    "setup-tesseract-arm64": "powershell -ExecutionPolicy Bypass -File scripts/setup-tesseract-arm64.ps1",
    "setup-poppler": "powershell -ExecutionPolicy Bypass -File scripts/setup-poppler.ps1",
    "setup-ollama": "powershell -ExecutionPolicy Bypass -File scripts/setup-ollama.ps1",
    "setup-windows-binaries": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows-binaries.ps1",
    "setup-architecture-binaries": "powershell -ExecutionPolicy Bypass -File scripts/setup-architecture-binaries.ps1",
    "verify-tesseract": "node scripts/verify-tesseract-setup.js",
    "verify-build-config": "node scripts/verify-build-config.js",
    "diagnose-backend": "node scripts/diagnose-python-backend.js",
    "diagnose-backend-packaged": "node scripts/diagnose-python-backend.js --packaged",
    "prebuild": "npm run prepare-backend && npm run setup-tesseract && npm run setup-tesseract-dlls && npm run setup-poppler",
    "build": "npm run package"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/plugin-fuses": "^7.4.0",
    "@electron-forge/plugin-webpack": "^7.4.0",
    "@electron-forge/publisher-github": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "adm-zip": "^0.5.16",
    "css-loader": "^6.0.0",
    "electron": "31.2.0",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "fork-ts-checker-webpack-plugin": "^7.2.13",
    "node-loader": "^2.0.0",
    "style-loader": "^3.0.0",
    "ts-loader": "^9.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~4.5.4"
  },
  "keywords": [],
  "author": {
    "name": "Kehn Marv",
    "email": "kehnmarv30@gmail.com"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/roboto": "^5.0.13",
    "@langchain/community": "^0.2.23",
    "@langchain/ollama": "^0.0.2",
    "@mui/icons-material": "^5.16.1",
    "@mui/material": "^5.16.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^1.8.8",
    "axios": "^1.13.2",
    "dotenv": "^16.4.5",
    "electron-log": "^5.1.7",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.1.0",
    "epub2": "^3.0.2",
    "html-to-text": "^9.0.5",
    "langchain": "^0.2.12",
    "mammoth": "^1.8.0",
    "office-text-extractor": "^3.0.3",
    "officeparser": "^4.1.1",
    "ollama": "^0.5.2",
    "pdf-parse": "^1.1.1",
    "pdf-parse-debugging-disabled": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.0.13",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.24.1",
    "react-syntax-highlighter": "^16.1.0",
    "react-window": "^2.2.3",
    "update-electron-app": "^3.0.0"
  },
  "license": "MIT",
  "repository": "github:Kehn-Marv/Pinguin"
}
